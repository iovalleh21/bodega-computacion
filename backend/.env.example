# Copia este archivo como .env y completa tus datos (.env NO se sube a GitHub)
PORT=3000

# `(local)` usa memoria compartida y funciona aunque TCP/IP no este habilitado.
DB_SERVER=(local)
DB_PORT=1433
DB_TRUSTED=true
DB_USER=sa
DB_PASSWORD=cambia_esta_clave
DB_NAME=BodegaComputadores
DB_DRIVER=ODBC Driver 18 for SQL Server

# true si el servidor exige conexión cifrada; en desarrollo local déjalo en false
DB_ENCRYPT=false
# en desarrollo se acepta el certificado autofirmado; usa false solo con un certificado válido
DB_TRUST_CERT=true
